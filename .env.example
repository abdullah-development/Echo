# Optional - copy to .env to customise. Replies run through your local Claude Code
# login (`claude -p`), so no API key is needed.

# Your name: used to write replies in your voice and to notice when someone addresses you.
MY_NAME=

# meeting = reply as you on a call; video = answer questions asked in videos/podcasts
MODE=meeting
# questions = auto-draft when a question is detected; every = let Claude judge every line; off = manual only
AUTO=questions

# Whisper model: tiny.en, base.en (default), small.en, medium.en, or tiny/base/small for other languages
WHISPER_MODEL=base.en
# LANGUAGE=en

# Leave empty to use your Claude Code default model, or e.g. opus / sonnet / haiku
CLAUDE_MODEL=
# low = fastest replies; medium/high = more careful answers
CLAUDE_EFFORT=low

PORT=8766

# Version 2 (hybrid) only: accurate model that corrects the quick transcript a few seconds later.
# Set to "off" to disable. CPU threads for each model (4 + 4 works best on an 8-core Intel Mac).
REFINE_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
FAST_THREADS=4
REFINE_THREADS=4
